# ============================================================
# Technical Documentation Assistant — Variables de Entorno
# Copiar a .env y completar con valores reales:
#   cp .env.example .env
# `.env` está en .gitignore: NUNCA commitear claves reales.
# Las claves (alias) coinciden con los Field(...) de src/config.py.
# ============================================================

# --- LLM / OpenRouter (REQUERIDO en producción) ---
# Gateway compatible con la API de OpenAI. Si está definido, reemplaza a OpenAI.
OPENROUTER_API_KEY=tu-openrouter-api-key-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- LLM / OpenAI (alternativa local, si no usás OpenRouter) ---
# Siempre se usa para EMBEDDINGS (OpenRouter no provee embeddings).
OPENAI_API_KEY=sk-...

# --- Pinecone (REQUERIDO en producción) ---
PINECONE_API_KEY=tu-pinecone-api-key-aqui
PINECONE_INDEX_NAME=nombre-de-tu-index
PINECONE_ENVIRONMENT=us-east-1-aws

# --- Clima (OPCIONAL) — herramienta get_weather ---
# OJO: clave de OpenWeatherMap (https://openweathermap.org/api), NO la de OpenAI.
OPENWEATHER_API_KEY=tu-api-key-de-openweathermap

# --- CORS (producción: dejar en * para Render) ---
# "*" => sin credenciales (spec CORS). Orígenes explícitos => credenciales habilitadas.
CORS_ORIGINS=*

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO
ENVIRONMENT=production
